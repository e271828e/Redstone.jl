+# Two logs snapshot by snapshot: the clock bitwise, the counters, the table
+# buffer by buffer.
+same_snapshots(a, b) =
+    length(a) == length(b) &&
+    all(s.t === r.t && s.frame == r.frame && s.boundary == r.boundary && same_table(s.store, r.store)
